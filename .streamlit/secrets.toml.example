# Copiar como .streamlit/secrets.toml y completar con tus claves reales
# NO subir secrets.toml a GitHub (ya está en .gitignore)

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY = "sk-or-v1-xxxxxxxxxxxxxxxxxxxx"

# NASA Earthdata token (https://urs.earthdata.nasa.gov/profile)
# Requerido para actualización mensual de nightlight
NASA_EARTHDATA_TOKEN = "xxxxxxxxxxxxxxxxxxxx"
